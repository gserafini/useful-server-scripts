# /etc/cron.d/wordfence-feed-ban: ban new Wordfence-reported attackers every 15 minutes.
# Every run appends one JSON line to the log; root is mailed only when a run is not "ok".
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
*/15 * * * * root out=$(/usr/bin/python3.12 -I /usr/local/useful-server-scripts/scripts/wordfence_feed_ban.py 2>&1); echo "$out" >> /var/log/wordfence-feed-ban.log; echo "$out" | grep -v '"result": "ok"' | /usr/bin/mail -E -s "[$(hostname -s)] Wordfence feed ban needs attention" root
